{
  "name": "studiopatron_app",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Patron customer-facing web application",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
